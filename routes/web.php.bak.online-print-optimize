                'total_invoices' => (int) ($totals->total_invoices ?? 0),
                'total_amount' => (float) ($totals->total_amount ?? 0),
                'last_voucher_date' => $s->last_voucher_date,
            ];
        })->values();

        return response()->json(['success' => true, 'suppliers' => $rows]);
