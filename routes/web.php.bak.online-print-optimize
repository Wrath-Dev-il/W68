// Fetch Purchase Note Items for Processing Modal
Route::get('/admin/purchase/purchase-order/items/{purchaseNoteId}', function (Request $request, $purchaseNoteId) {
    $user = session('user');
    if (!$user) return response()->json(['error' => 'Unauthorized'], 403);

    try {
        $purchaseNote = \App\Models\PurchaseNote::find($purchaseNoteId);
        if (!$purchaseNote) {
            return response()->json(['success' => false, 'message' => 'Purchase note not found'], 404);
        }

        $purchaseOrderLinkValues = collect([
            (string) ($purchaseNote->reference_number ?? ''),
            (string) ($purchaseNote->purchase_note_number ?? ''),
        ])->filter()->unique()->values();

        $relatedPurchaseOrders = \App\Models\PurchaseOrder::with('items')
            ->whereIn('reference_number', $purchaseOrderLinkValues)
            ->orderBy('id', 'asc')
            ->get();

        $existingInvoices = $relatedPurchaseOrders
            ->pluck('supplier_invoice_number')
            ->flatMap(function ($invoiceText) {
                return collect(explode(',', (string) $invoiceText))
                    ->map(fn ($invoice) => trim((string) $invoice))
                    ->filter();
            })
            ->unique()
            ->values()
            ->all();

        $normalizePurchaseItemText = function ($value) {
            return preg_replace('/\s+/', ' ', trim((string) $value));
        };

        $historicalItemMetaByProductId = [];
        $historicalItemMetaByCode = [];
        foreach ($relatedPurchaseOrders as $purchaseOrder) {
            foreach ($purchaseOrder->items as $orderItem) {
                $normalizedCode = $normalizePurchaseItemText($orderItem->product_code ?? '');
                $normalizedDescription = $normalizePurchaseItemText($orderItem->description ?? '');
                $historyKey = $normalizedCode !== '' ? $normalizedCode : $normalizedDescription;
                $productIdKey = !empty($orderItem->product_id) ? (string) $orderItem->product_id : '';

                if ($productIdKey === '' && $historyKey === '') {
                    continue;
                }

                $metaTemplate = [
                    'original_quantity' => (float) ($orderItem->quantity ?? 0),
                    'served_quantity' => 0,
                ];

                if ($productIdKey !== '' && !isset($historicalItemMetaByProductId[$productIdKey])) {
                    $historicalItemMetaByProductId[$productIdKey] = $metaTemplate;
                }

                if ($historyKey !== '' && !isset($historicalItemMetaByCode[$historyKey])) {
                    $historicalItemMetaByCode[$historyKey] = $metaTemplate;
                }

                if ($productIdKey !== '') {
                    $historicalItemMetaByProductId[$productIdKey]['served_quantity'] += (float) ($orderItem->actual_quantity ?? 0);
                }

                if ($historyKey !== '') {
                    $historicalItemMetaByCode[$historyKey]['served_quantity'] += (float) ($orderItem->actual_quantity ?? 0);
                }
            }
        }

        $items = \App\Models\PurchaseNoteItem::where('purchase_note_id', $purchaseNoteId)
            ->get()
            ->map(function ($item) use ($historicalItemMetaByProductId, $historicalItemMetaByCode, $normalizePurchaseItemText) {
                $productIdKey = !empty($item->product_id) ? (string) $item->product_id : '';
                $normalizedCode = $normalizePurchaseItemText($item->product_code ?? '');
                $normalizedDescription = $normalizePurchaseItemText($item->description ?? '');
                $history = null;

                if ($productIdKey !== '' && isset($historicalItemMetaByProductId[$productIdKey])) {
                    $history = $historicalItemMetaByProductId[$productIdKey];
                } elseif ($normalizedCode !== '' && isset($historicalItemMetaByCode[$normalizedCode])) {
                    $history = $historicalItemMetaByCode[$normalizedCode];
                } elseif ($normalizedDescription !== '' && isset($historicalItemMetaByCode[$normalizedDescription])) {
                    $history = $historicalItemMetaByCode[$normalizedDescription];
                }

                $baseQty = $history ? (float) ($history['original_quantity'] ?? 0) : (float) ($item->quantity ?? 0);
                $servedQty = $history ? (float) ($history['served_quantity'] ?? 0) : 0;
                $remainingQty = $history ? max(0, $baseQty - $servedQty) : (float) ($item->quantity ?? 0);

                return [
                    'id' => $item->id,
                    'product_id' => $item->product_id,
                    'product_code' => $item->product_code,
                    'part_number' => $item->part_number,
                    'description' => $item->description,
                    'quantity' => $remainingQty,
                    'actual_quantity' => $remainingQty,
                    'unit_price' => $item->unit_price,
                    'total_price' => $remainingQty * (float) ($item->unit_price ?? 0),
                    'currency' => $item->currency ?? 'PHP',
                    'conversion_rate' => $item->conversion_rate,
                    'unit_price_converted' => $item->unit_price_converted,
                    'total_price_converted' => $item->total_price_converted,
                    'unit' => $item->unit,
                ];
            })
            ->when(strcasecmp((string) $purchaseNote->status, 'Partial') === 0, function ($collection) {
                return $collection->filter(fn ($item) => (float) ($item['quantity'] ?? 0) > 0)->values();
            })
            ->values();

        return response()->json([
            'success' => true,
            'note' => [
                'id' => $purchaseNote->id,
                'purchase_note_number' => $purchaseNote->purchase_note_number,
                'date' => $purchaseNote->date,
                'supplier_code' => $purchaseNote->supplier->supplier_code ?? '',
                'supplier_name' => $purchaseNote->supplier->name ?? '',
                'total_amount' => $purchaseNote->total_amount,
                'status' => $purchaseNote->status,
                'reference_number' => $purchaseNote->reference_number,
                'existing_invoice_numbers' => $existingInvoices,
                'currency' => $purchaseNote->currency ?? 'PHP',
                'conversion_rate' => $purchaseNote->conversion_rate,
            ],
            'items' => $items,
        ]);
    } catch (\Exception $e) {
        return response()->json(['success' => false, 'message' => $e->getMessage()], 500);
    }
})->name('admin.purchase-order.items');

// Fetch Purchase Orders linked to a Purchase Note (by note number)
Route::get('/admin/purchase/purchase-order/by-note/{purchaseNoteNumber}', function ($purchaseNoteNumber) {
    try {
        $note = \App\Models\PurchaseNote::where('purchase_note_number', $purchaseNoteNumber)->first();
        $noteStatus = $note ? $note->status : null;

        $purchaseOrders = \App\Models\PurchaseOrder::where('reference_number', $purchaseNoteNumber)
            ->orderBy('date', 'desc')
            ->get(['id', 'po_number', 'receiving_number', 'supplier_invoice_number', 'date', 'status']);

        // For closed notes, use the note's status for all POs; otherwise show real PO status
        if ($noteStatus && strtoupper($noteStatus) === 'CLOSED') {
            $purchaseOrders->each(function ($po) use ($noteStatus) {
                $po->status = $noteStatus;
            });
        }

        // Calculate remaining PN items (uninvoiced quantities) for non-closed notes
        $remainingItems = [];
        if ($note && strtoupper($note->status) !== 'CLOSED') {
            $pnItems = \App\Models\PurchaseNoteItem::where('purchase_note_id', $note->id)->get();
            $allPoItems = \App\Models\PurchaseOrderItem::whereHas('purchaseOrder', function($q) use ($purchaseNoteNumber) {
                $q->where('reference_number', $purchaseNoteNumber);
            })->get();

            // Sum PO item actual_quantities per normalized product_code
            $poItemTotals = [];
            foreach ($allPoItems as $poi) {
                $code = preg_replace('/\s+/', ' ', trim($poi->product_code));
                $poItemTotals[$code] = ($poItemTotals[$code] ?? 0) + (float)($poi->actual_quantity ?? $poi->quantity);
            }

            foreach ($pnItems as $pni) {
                $normalizedCode = preg_replace('/\s+/', ' ', trim($pni->product_code));
                $servedQty = $poItemTotals[$normalizedCode] ?? 0;

                // PN item quantity was already reduced by PO processing (qty - actual_qty).
                // Use PO original quantities to determine the true to-process remainder.
                $matchingPOItems = $allPoItems->filter(function ($poi) use ($normalizedCode) {
                    $poiCode = preg_replace('/\s+/', ' ', trim($poi->product_code));
                    return $poiCode === $normalizedCode;
                });
                $poOriginalQty = $matchingPOItems->sum('quantity');
                $poActualQty = $matchingPOItems->sum('actual_quantity');

                if ($poOriginalQty > 0) {
                    $remainingQty = max(0, (float)$poOriginalQty - (float)$poActualQty);
                } else {
                    $remainingQty = (float)$pni->quantity;
                }

                if ($remainingQty > 0) {
                    $remainingItems[] = [
                        'id' => $pni->id,
                        'product_id' => $pni->product_id,
                        'product_code' => $pni->product_code,
                        'part_number' => $pni->part_number,
                        'description' => $pni->description,
                        'quantity' => $remainingQty,
                        'unit_price' => (float)$pni->unit_price,
                        'unit' => $pni->unit ?? '',
                    ];
                }
            }

            // Add virtual Open entry if there are remaining items and at least one Partial PO
            $hasPartial = $purchaseOrders->contains(function ($po) {
                return strtoupper($po->status) === 'PARTIAL';
            });
            if ($hasPartial && count($remainingItems) > 0) {
                $purchaseOrders->push((object)[
                    'id' => 0,
                    'po_number' => $purchaseNoteNumber,
                    'receiving_number' => '',
                    'supplier_invoice_number' => '',
                    'date' => null,
                    'status' => 'Open',
                ]);
            }
        }

        return response()->json([
            'success' => true,
            'invoices' => $purchaseOrders,
            'note_status' => $noteStatus,
            'remaining_items' => $remainingItems,
        ]);
    } catch (\Exception $e) {
        return response()->json(['success' => false, 'message' => $e->getMessage()], 500);
    }
})->name('admin.purchase-order.by-note');

