                DB::raw('COUNT(DISTINCT i.id) as total_invoices'),
                DB::raw('COALESCE(SUM(i.amount_paid), 0) as total_amount')
            )
            ->where('v.is_draft', false)
            ->whereIn('v.supplier_id', $supplierIds)
            ->groupBy('v.supplier_id')
            ->get()
            ->keyBy('supplier_id');

        $rows = $suppliers->map(function ($s) use ($codes, $supplierTotals) {
