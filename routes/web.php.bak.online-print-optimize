                ];
            }
        } else {
            // Render from DB items (original behavior)
            // Use QTY/OUM from notes_data if available (user may have edited them in Step 2)
            $itemCollection = $note->items()->orderBy('id')->get()->values();
            foreach ($itemCollection as $itemIdx => $item) {
                $product = \App\Models\Product::on('masterlist')->find($item->product_id);
