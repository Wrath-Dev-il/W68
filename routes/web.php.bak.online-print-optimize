    }

    // Pre-build lookup maps for online/local classification (replaces expensive SQL EXISTS subqueries)
    $salesByProduct = [];
    if (!empty($productIds)) {
        // 1. Flatten all invoice numbers from online_reports
        $onlineInvoiceNumbers = [];
        \App\Models\OnlineReport::on('sales')
            ->select('invoice_numbers')
            ->orderBy('id')
            ->chunk(500, function ($reports) use (&$onlineInvoiceNumbers) {
                foreach ($reports as $r) {
                    $nums = $r->invoice_numbers;
                    if (is_string($nums)) $nums = json_decode($nums, true);
                    if (is_array($nums)) {
                        foreach ($nums as $n) {
                            $onlineInvoiceNumbers[trim((string)$n)] = true;
                        }
                    }
                }
            });

        // 2. Build set of sales_note_ids from online_reports
        $onlineNoteIdSet = [];
        \App\Models\OnlineReport::on('sales')
            ->select('sales_note_ids')
            ->orderBy('id')
            ->chunk(500, function ($reports) use (&$onlineNoteIdSet) {
                foreach ($reports as $r) {
                    foreach (explode(',', $r->sales_note_ids) as $sid) {
                        $sid = trim($sid);
                        if ($sid !== '') $onlineNoteIdSet[$sid] = true;
                    }
                }
            });

        // 3. Build set of sales order identifiers linked to online_reports
        $onlineOrderNumbers = [];
        $onlineInvoiceNumbersFromSO = [];
        if (!empty($onlineNoteIdSet)) {
            \Illuminate\Support\Facades\DB::connection('sales')
                ->table('sales_orders')
                ->select('order_number', 'invoice_numbers')
                ->whereIn('sales_note_id', array_keys($onlineNoteIdSet))
                ->orderBy('id')
                ->chunk(500, function ($orders) use (&$onlineOrderNumbers, &$onlineInvoiceNumbersFromSO) {
                    foreach ($orders as $so) {
                        if (!empty($so->order_number)) $onlineOrderNumbers[trim($so->order_number)] = true;
                        if (!empty($so->invoice_numbers)) {
                            $invNums = $so->invoice_numbers;
                            if (is_string($invNums)) $invNums = json_decode($invNums, true) ?? [];
                            if (is_array($invNums)) {
                                foreach ($invNums as $inv) {
                                    $onlineInvoiceNumbersFromSO[trim((string)$inv)] = true;
                                }
                            }
                        }
                    }
                });
        }

        // Merge all online invoice number sets
        $allOnlineInvoiceNumbers = array_merge($onlineInvoiceNumbers, $onlineInvoiceNumbersFromSO);

        // 4. Build sales return maps
        $onlineCustomerNames = ['LAZADA ONLINE BUYERS', 'SHOPEE ONLINE BUYERS', 'TIKTOK SHOP', 'TIKTOK ONLINE BUYERS'];
        $onlineReturnNumbers = [];
        $salesReturns = \Illuminate\Support\Facades\DB::connection('sales')
            ->table('sales_returns')
            ->select('return_number', 'invoice_no', 'customer_name')
            ->get();
        foreach ($salesReturns as $sr) {
            $srNum = trim($sr->return_number ?? '');
            $srInv = trim($sr->invoice_no ?? '');
            $srCust = trim(strtoupper($sr->customer_name ?? ''));
            $isOnline = in_array($srCust, $onlineCustomerNames)
                || (isset($allOnlineInvoiceNumbers[$srInv]));
            if ($isOnline) {
                if ($srNum !== '') $onlineReturnNumbers[$srNum] = true;
                if ($srInv !== '') $onlineReturnNumbers[$srInv] = true;
            }
        }

        // 5. Simple ledger query (no EXISTS subqueries)
        $rawRows = \App\Models\ProductLedger::from('product_ledgers as pl')
            ->whereIn('pl.product_id', array_keys($productIds))
            ->where(function ($query) {
                $query->whereIn('pl.transaction_type', ['OUT', 'CHGINVC'])
                    ->orWhere(function ($q) {
                        $q->where('pl.transaction_type', 'IN')
                            ->where(function ($remarks) {
                                $remarks->whereRaw("LOWER(COALESCE(pl.remarks,'')) LIKE '%salrtn%'")
                                    ->orWhereRaw("LOWER(COALESCE(pl.remarks,'')) LIKE '%sales return%'");
                            });
                    });
            })
            ->selectRaw("pl.product_id, YEAR(pl.date) as yr, pl.transaction_type, pl.quantity_out, pl.quantity_in, LOWER(COALESCE(pl.remarks,'')) as remarks_lower, LOWER(COALESCE(pl.reference_number,'')) as ref_number_lower, LOWER(COALESCE(pl.transaction_number,'')) as trans_number_lower")
            ->get();

        // 6. Classify each row in PHP using lookup maps, then aggregate
        foreach ($rawRows as $row) {
            $ref = trim($row->ref_number_lower);
            $trans = trim($row->trans_number_lower);
            $remarks = $row->remarks_lower;

            // Classify as online or local (priority order matches original CASE)
            $salesType = 'local';
            if ($remarks === 'online report generation') {
                $salesType = 'online';
            } elseif (isset($allOnlineInvoiceNumbers[$ref]) || isset($allOnlineInvoiceNumbers[$trans])) {
                $salesType = 'online';
            } elseif (isset($onlineReturnNumbers[$ref]) || isset($onlineReturnNumbers[$trans])) {
                $salesType = 'online';
            } elseif (isset($onlineOrderNumbers[$ref]) || isset($onlineOrderNumbers[$trans])
                      || isset($onlineInvoiceNumbersFromSO[$ref]) || isset($onlineInvoiceNumbersFromSO[$trans])) {
                $salesType = 'online';
            }

            // Calculate qty (preserve CHGINVC=positive, SALRTN=deduction)
            if ($row->transaction_type === 'IN'
                && (strpos($remarks, 'salrtn') !== false || strpos($remarks, 'sales return') !== false)) {
                $qty = -(int)$row->quantity_in;
            } elseif ($row->transaction_type === 'CHGINVC') {
                $qty = abs((int)$row->quantity_out);
            } else {
                $qty = (int)$row->quantity_out;
            }

            $key = $row->product_id . '-' . $row->yr . '-' . $salesType;
            $salesByProduct[$key] = ($salesByProduct[$key] ?? 0) + $qty;
        }
    }

    return view('Admin.sales.online-report-print', [
        'report' => $report,
        'notes' => $notes,
        'prices' => $prices,
        'dateRanges' => $dateRanges,
        'salesByProduct' => $salesByProduct,
    ]);
})->name('admin.sales-order.online-print');

