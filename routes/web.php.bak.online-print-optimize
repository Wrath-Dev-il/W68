                // 3. price_online > 0, 4. unit_price > 0, 5. selling_price > 0, 6. 0
                $_resolvedPrice = 0;
                if ($item->product_id && isset($prices[(string)$item->product_id]) && (float)$prices[(string)$item->product_id] > 0) {
