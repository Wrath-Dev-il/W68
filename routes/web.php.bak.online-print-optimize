    Route::match(['GET', 'POST'], '/master-list/product-master/data', function (\Illuminate\Http\Request $req) {
        $user = session('user'); if (!$user) return response()->json(['error' => 'Unauthorized'], 403);
        $perPage = $req->query('perPage', 50); $tab = $req->query('tab', 'all'); $search = $req->query('search', []); $filter = $req->query('filter', []);
        $ledgerDatabase = str_replace('`', '``', (string) config('database.connections.ledger.database'));
        $latestBalanceSql = "(SELECT pl.balance_stock FROM `{$ledgerDatabase}`.`product_ledgers` pl WHERE pl.product_id = products.id ORDER BY pl.`date` DESC, pl.id DESC LIMIT 1)";
        $ledgerOnHandSql = "COALESCE({$latestBalanceSql}, 0)";
        $query = \App\Models\Product::query()->select('products.*')->selectRaw("{$ledgerOnHandSql} as latest_on_hand");
        $sortBy = $req->query('sort_by');
        $sortDirection = strtolower($req->query('sort_direction', 'asc')) === 'desc' ? 'desc' : 'asc';
        if ($tab === 'newly') $query->where('status', 'Newly'); elseif ($tab === 'low') $query->whereRaw("{$ledgerOnHandSql} < ?", [20]);
        $escapeLike = function ($value) { return str_replace(['\\', '%', '_'], ['\\\\', '\\%', '\\_'], (string) $value); };
        if (!empty($search)) foreach ($search as $col => $val) { if (empty($val)) continue; $db = match($col) { 'productCode' => 'product_code', 'partNumber' => 'part_number', 'onHand' => 'on_hand', 'sellingPrice' => 'selling_price', 'priceOnline' => 'price_online', 'description' => 'description', 'application' => 'application', 'specification' => 'specification', 'position' => 'position', 'category' => 'category', default => $col }; $term = $escapeLike($val); if ($col === 'onHand') $query->whereRaw("CAST({$ledgerOnHandSql} AS CHAR) LIKE ?", ["%$term%"]); elseif ($col === 'priceOnline') $query->whereRaw('price_online LIKE ?', ['%' . $term . '%']); else $query->where($db, 'LIKE', "%$term%"); }
        if (!empty($filter)) { if (!empty($filter['category']) && $filter['category'] !== 'all') $query->where('category', 'LIKE', "%{$filter['category']}%"); if (!empty($filter['application']) && $filter['application'] !== 'all') $query->where('application', 'LIKE', "%{$filter['application']}%"); if (!empty($filter['status']) && $filter['status'] !== 'all') $query->where('status', $filter['status']); }
        $sortableColumns = [
            'productCode' => 'product_code',
            'description' => 'description',
            'application' => 'application',
            'brand' => 'category',
            'partNumber' => 'part_number',
            'position' => 'position',
            'specification' => 'specification',
            'unit' => 'unit',
            'priceOnline' => 'price_online',
            'sellingPrice' => 'selling_price',
            'onHand' => 'on_hand',
        ];
        if ($sortBy && isset($sortableColumns[$sortBy])) {
            $query->orderBy($sortableColumns[$sortBy], $sortDirection);
        } else {
            $query->orderBy('created_at', 'desc');
        }
        $products = $query->paginate($perPage);
        $productIds = collect($products->items())->pluck('id')->filter();
        $latestLedgerMap = collect();
        if ($productIds->isNotEmpty()) {
            try {
                $latestLedgerMap = DB::connection('ledger')->table('product_ledgers')->whereIn('product_id', $productIds)->orderBy('date', 'desc')->orderBy('id', 'desc')->get(['product_id', 'balance_stock'])->groupBy('product_id')->map(fn ($rows) => (int) ($rows->first()->balance_stock ?? 0));
            } catch (\Throwable $e) {
                $latestLedgerMap = collect();
            }
        }
        $products->getCollection()->transform(function ($product) use ($latestLedgerMap) {
            $product->on_hand = $latestLedgerMap->get($product->id, 0);

            // Sanitize text string fields to prevent JSON encoding errors (skip binary/image fields)
            foreach ($product->getAttributes() as $field => $value) {
                if ($field === 'Product_Picture' || $field === 'images') continue;
                if (is_string($value)) {
                    $product->$field = iconv('UTF-8', 'UTF-8//IGNORE', $value);
                }
            }

            // Normalize product image: handle raw binary, JSON arrays, and file paths
            if (!empty($product->Product_Picture)) {
                $pic = $product->Product_Picture;
                $firstByte = $pic[0];
                // 1) Raw PNG binary (starts with PNG magic bytes \x89PNG)
                if (ord($firstByte) === 137 && isset($pic[3]) && ord($pic[1]) === 80 && ord($pic[2]) === 78 && ord($pic[3]) === 71) {
                    $product->Product_Picture = 'data:image/png;base64,' . base64_encode($pic);
                }
                // 2) Raw JPG binary (starts with \xFF\xD8\xFF)
                elseif (ord($firstByte) === 255 && isset($pic[2]) && ord($pic[1]) === 216 && ord($pic[2]) === 255) {
                    $product->Product_Picture = 'data:image/jpeg;base64,' . base64_encode($pic);
                }
                // 3) JSON array/object of image URLs
                elseif ($firstByte === '[' || $firstByte === '{') {
                    $decoded = json_decode($pic, true);
                    if (empty($decoded)) {
                        $product->Product_Picture = null;
                    } else {
                        $product->Product_Picture = $decoded;
                    }
                }
                // 4) Already a data URL — pass through
                elseif (str_starts_with($pic, 'data:image/')) {
                    // keep as-is
                }
                // 5) HTTP/HTTPS URL — pass through
                elseif (str_starts_with($pic, 'http://') || str_starts_with($pic, 'https://')) {
                    // keep as-is
                }
                // 6) File path — convert to public URL via url()
                elseif (preg_match('/\.(png|jpg|jpeg|webp|gif|bmp|svg)(\?.*)?$/i', $pic)) {
                    $product->Product_Picture = url($pic);
                }
                // 7) Unknown format — set to null
                else {
                    $product->Product_Picture = null;
                }
            } else {
                $product->Product_Picture = null;
            }

            return $product;
        });
        $stats = \Illuminate\Support\Facades\DB::connection('masterlist')->selectOne("
            SELECT
                COUNT(*) as total,
                SUM(CASE WHEN p.status = 'Newly' THEN 1 ELSE 0 END) as newly,
                SUM(CASE WHEN COALESCE(lb.balance_stock, 0) < 20 THEN 1 ELSE 0 END) as low
            FROM products p
