                        'oum' => $itemData['unit'] ?? ($product ? $product->unit : null),
                        'price' => $itemUnitPrice,
                        'cost' => $itemUnitPrice,
                        'remarks' => 'Purchase Order Update - New Items Added'
                    ]);
                } catch (\Exception $ledgerError) {
                    \Log::error('ProductLedger creation failed during PO update', [
                        'error' => $ledgerError->getMessage(),
                        'product_code' => $itemData['product_code'],
                        'po_number' => $po->po_number
                    ]);
                }

                // Update product stock
                if ($product) {
                    $product->increment('on_hand', $itemActualQty);
                }
            }

            $totalAmount += $subtotal;
            $actualTotalAmount += $actualSubtotal;
        }

        // Update product costs for all saved PO items
        $poItems = \App\Models\PurchaseOrderItem::where('purchase_order_id', $po->id)->get();

        foreach ($poItems as $poItem) {
            $productId = (int) ($poItem->product_id ?? 0);
