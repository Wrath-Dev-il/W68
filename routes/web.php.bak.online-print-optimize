        // Group vouchers by supplier
        $suppliers = DB::connection('accounting')->table('payable_cheque_vouchers')
            ->select(
                'supplier_id',
                'supplier_name',
                DB::raw('COUNT(*) as voucher_count'),
                DB::raw('MAX(voucher_date) as last_voucher_date')
            )
            ->where('is_draft', false)
            ->groupBy('supplier_id', 'supplier_name')
            ->orderBy('last_voucher_date', 'desc')
            ->get();

        $supplierIds = $suppliers->pluck('supplier_id')->filter()->unique()->values();
        
        // Get supplier codes
        $codes = collect();
        if ($supplierIds->isNotEmpty()) {
            $codes = DB::connection('masterlist')->table('suppliers')
                ->whereIn('id', $supplierIds)
                ->select('id', 'supplier_code')
                ->get()
                ->keyBy('id');
        }

        // Get total amounts per supplier
        $supplierTotals = DB::connection('accounting')->table('payable_cheque_vouchers as v')
