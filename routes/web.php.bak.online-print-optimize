// Sales Order - Update (full replace of items + ledger reversal)
Route::post('/admin/sales/sales-order/update/{salesOrderId}', function (Request $request, $salesOrderId) {
    $user = session('user');
    if (!$user) return response()->json(['error' => 'Unauthorized'], 403);
    try {
        // Load specific sales_order (invoice) to edit
        $so = \App\Models\SalesOrder::on('sales')->find($salesOrderId);
        if (!$so) return response()->json(['success' => false, 'message' => 'Sales order not found.'], 404);

        $note = \App\Models\SalesNote::on('sales')->find($so->sales_note_id);
        if (!$note) return response()->json(['success' => false, 'message' => 'Sales note not found.'], 404);

        $validator = Validator::make($request->all(), [
            'invoice_number' => 'nullable|string',
            'invoices' => 'nullable|array',
            'invoices.*' => 'nullable|string',
            'waybill_no' => 'nullable|string',
            'waybill_date' => 'nullable|date',
            'remarks' => 'nullable|string',
            'items' => 'required|array|min:1',
            'items.*.sales_order_item_id' => 'nullable|integer',
            'items.*.product_id' => 'required|integer|min:1',
            'items.*.product_code' => 'required|string',
            'items.*.description' => 'nullable|string',
            'items.*.quantity' => 'required|numeric|min:0',
            'items.*.actual_qty' => 'required|numeric|min:0',
            'items.*.additional_qty' => 'nullable|numeric|min:0',
            'items.*.oum' => 'nullable|string',
            'items.*.unit_price' => 'required|numeric|min:0',
            'items.*.discount' => 'nullable|numeric|min:0',
            'items.*.additional_discount' => 'nullable|numeric|min:0',
            'items.*.price_code' => 'nullable|string',
            'items.*.subtotal' => 'required|numeric|min:0',
            'items.*.particulars' => 'nullable|string',
        ]);
        $validator->after(function ($validator) use ($request) {
            $seenProductIds = [];
            $seenItemIds = [];

            foreach ((array) $request->input('items', []) as $index => $item) {
                $qty = (float) ($item['quantity'] ?? 0);
                $actualQty = (float) ($item['actual_qty'] ?? 0);
                if ($actualQty > $qty) {
                    $validator->errors()->add(
                        "items.$index.actual_qty",
                        'Actual QTY cannot exceed QTY for item '
                        . ($item['product_code'] ?? ($index + 1))
                        . '.'
                    );
                }

                $productId = (int) ($item['product_id'] ?? 0);
                if ($productId > 0 && isset($seenProductIds[$productId])) {
                    $validator->errors()->add(
                        "items.$index.product_id",
                        'Duplicate products are not allowed in one Sales Order.'
                    );
                }
                if ($productId > 0) {
                    $seenProductIds[$productId] = true;
                }

                $salesOrderItemId = (int) ($item['sales_order_item_id'] ?? 0);
                if ($salesOrderItemId > 0 && isset($seenItemIds[$salesOrderItemId])) {
                    $validator->errors()->add(
                        "items.$index.sales_order_item_id",
                        'Duplicate Sales Order item IDs are not allowed.'
                    );
                }
                if ($salesOrderItemId > 0) {
                    $seenItemIds[$salesOrderItemId] = true;
                }
            }
        });

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => $validator->errors()->first(),
                'errors' => $validator->errors(),
            ], 422);
        }

        $data = $validator->validated();
        $invoiceNumber = $data['invoice_number'] ?? $so->invoice_numbers;
        $items = $data['items'];
        $waybillNo = $data['waybill_no'] ?? '';
        $waybillDate = $data['waybill_date'] ?? '';
        $remarks = $data['remarks'] ?? '';
        $invoices = $data['invoices'] ?? [];

        try {
            \Illuminate\Support\Facades\DB::connection('sales')->beginTransaction();
            \Illuminate\Support\Facades\DB::connection('ledger')->beginTransaction();
            \Illuminate\Support\Facades\DB::connection('masterlist')->beginTransaction();

            $soBefore = $so->toArray();
            $noteBefore = $note->toArray();

            $customer = null;
            if (!empty($so->customer_id)) {
                $customer = \App\Models\Customer::on('masterlist')->find($so->customer_id);
            }

            // 1. Build old qty map from existing sales order items BEFORE we delete them
            $existingItems = $so->items()->get();
            $oldQtyMap = [];
            foreach ($existingItems as $ei) {
                $oldQtyMap[(int) $ei->product_id] = (float) ($ei->actual_qty ?? 0);
            }
            
            \Log::info('Old SO Items Map', ['oldQtyMap' => $oldQtyMap]);

            // 1b. Build sales note qty map (to check what was already deducted)
            $noteItems = \Illuminate\Support\Facades\DB::connection('sales')
                ->table('sales_note_items')
                ->where('sales_note_id', $note->id)
                ->get(['product_id', 'quantity', 'additional_qty']);
            $noteQtyMap = [];
            foreach ($noteItems as $ni) {
                // Include both quantity and additional_qty for accurate comparison
                $totalNoteQty = (float) ($ni->quantity ?? 0) + (float) ($ni->additional_qty ?? 0);
                $noteQtyMap[(int) $ni->product_id] = $totalNoteQty;
            }
            
            \Log::info('Sales Note Items Map', ['noteQtyMap' => $noteQtyMap]);

            // 2. Delete old sales_order_items NOW (after capturing oldQtyMap)
            \Illuminate\Support\Facades\DB::connection('sales')
                ->table('sales_order_items')
                ->where('sales_order_id', $so->id)
                ->delete();

            // 3. Process new items — net difference only
            $normalizedInvoices = collect(is_array($invoices) ? $invoices : [])
                ->map(fn ($v) => trim((string) $v))
                ->filter(fn ($v) => $v !== '')
                ->unique()
                ->values();

            // Build latest ledger balance map
            $itemPids = collect($items)->pluck('product_id')->filter()->unique()->values()->all();
            $ledgerBalanceMap = [];
            if (!empty($itemPids)) {
                $latestPl = DB::connection('ledger')
                    ->table('product_ledgers as pl')
                    ->selectRaw('pl.product_id, MAX(pl.created_at) as max_ca')
                    ->whereIn('pl.product_id', $itemPids)
                    ->groupBy('pl.product_id');
                $latestPlIds = DB::connection('ledger')
                    ->table('product_ledgers as pl')
                    ->joinSub($latestPl, 'lc', fn ($j) => $j->on('pl.product_id', '=', 'lc.product_id')->on('pl.created_at', '=', 'lc.max_ca'))
                    ->selectRaw('MAX(pl.id) as id')
                    ->groupBy('pl.product_id');
                $ledgerRows = DB::connection('ledger')
                    ->table('product_ledgers')
                    ->whereIn('id', $latestPlIds)
                    ->get(['product_id', 'balance_stock']);
                foreach ($ledgerRows as $r) {
                    $ledgerBalanceMap[(int) $r->product_id] = (float) ($r->balance_stock ?? 0);
                }
            }

            $requestTotalAmount = 0;
            $processedCount = 0;
            $processedPids = [];

            foreach ($items as $itemData) {
                $productId = (int) ($itemData['product_id'] ?? 0);
                $newQty = (float) ($itemData['actual_qty'] ?? 0);
                if ($newQty <= 0) continue;

                $product = \App\Models\Product::on('masterlist')->find($productId);
                if (!$product) continue;

                $processedPids[] = $productId;
                $oldQty = (float) ($oldQtyMap[$productId] ?? 0);
                $noteQty = (float) ($noteQtyMap[$productId] ?? 0);
                
                // Calculate the actual difference
                $diff = $newQty - $oldQty;

                // DEBUG LOGGING
                \Log::info('Edit SO Item Processing', [
                    'product_id' => $productId,
                    'product_code' => $itemData['product_code'] ?? '',
                    'newQty' => $newQty,
                    'oldQty' => $oldQty,
                    'noteQty' => $noteQty,
                    'diff' => $diff,
                    'scenario' => $oldQty == 0 && $noteQty > 0 ? '1-FromNote' : ($oldQty > 0 ? '2-InOldSO' : '3-BrandNew'),
                ]);

                // Insert new sales_order_item
                \Illuminate\Support\Facades\DB::connection('sales')->table('sales_order_items')->insert([
                    'sales_order_id' => $so->id,
                    'product_id' => $productId,
                    'product_code' => $itemData['product_code'] ?? '',
                    'price_code' => $itemData['price_code'] ?? '',
                    'description' => $itemData['description'] ?? '',
                    'quantity' => $itemData['quantity'] ?? 0,
                    'actual_qty' => $newQty,
                    'additional_qty' => $itemData['additional_qty'] ?? 0,
                    'oum' => $itemData['oum'] ?? 'PCS',
                    'unit_price' => $itemData['unit_price'] ?? 0,
                    'discount' => $itemData['discount'] ?? 0,
                    'additional_discount' => $itemData['additional_discount'] ?? 0,
                    'subtotal' => $itemData['subtotal'] ?? 0,
                    'particulars' => $itemData['particulars'] ?? '',
                    'created_at' => now(),
                    'updated_at' => now(),
                ]);

                $requestTotalAmount += (float) ($itemData['subtotal'] ?? 0);
                $baseBalance = (float) ($ledgerBalanceMap[(int) $productId] ?? $product->on_hand ?? 0);

                // Ledger adjustment logic - only create entries when there's actual stock movement
                // SCENARIO 1: Item NOT in old SO, but IS in Sales Note (stock already deducted)
                if ($oldQty == 0 && $noteQty > 0) {
                    \Log::info('Scenario 1: Item from Sales Note', [
                        'newQty' => $newQty,
                        'noteQty' => $noteQty,
                        'will_create_ledger' => true, // Always create ledger for NEW items
                    ]);
                    // NEW LOGIC: Always create ledger entry for items from Sales Note
                    // because Sales Note update does NOT create ledger entries anymore
                    \App\Models\ProductLedger::create([
                        'product_id' => $product->id,
                        'customer_id' => $so->customer_id,
                        'transaction_type' => 'OUT',
                        'date' => now()->toDateString(),
                        'transaction_number' => $so->order_number,
                        'reference_number' => $normalizedInvoices->implode(', '),
                        'entity_name' => $so->customer_name,
                        'quantity_in' => 0,
                        'quantity_out' => $newQty,
                        'balance_stock' => max(0, $baseBalance - $newQty),
                        'oum' => $itemData['oum'] ?? 'PCS',
                        'price' => $itemData['unit_price'] ?? 0,
                        'cost' => $product->cost ?? 0,
                        'remarks' => 'Sales Order Edit - New Item from Sales Note',
                    ]);
                    \Log::info('Created ledger entry for Sales Note item', ['newQty' => $newQty]);
                    $product->on_hand = max(0, ($product->on_hand ?? 0) - $newQty);
                }
                // SCENARIO 2: Item WAS in old SO (has previous SO quantity)
                else if ($oldQty > 0) {
                    // Check if ledger entry exists for this transaction
                    $hasLedgerWithTxn = DB::connection('ledger')->table('product_ledgers')
                        ->where('product_id', $productId)
                        ->where('transaction_number', $so->order_number)
                        ->exists();
                    
                    \Log::info('Scenario 2: Item in old SO', [
                        'diff' => $diff,
                        'hasLedgerWithTxn' => $hasLedgerWithTxn
                    ]);
                    
                    // If no ledger entry exists but item is in old SO, create initial entry
                    if (!$hasLedgerWithTxn) {
                        \Log::info('Creating initial ledger entry for old SO item without ledger');
                        \App\Models\ProductLedger::create([
                            'product_id' => $product->id,
                            'customer_id' => $so->customer_id,
                            'transaction_type' => 'OUT',
                            'date' => now()->toDateString(),
                            'transaction_number' => $so->order_number,
                            'reference_number' => $normalizedInvoices->implode(', '),
                            'entity_name' => $so->customer_name,
                            'quantity_in' => 0,
                            'quantity_out' => $newQty,
                            'balance_stock' => max(0, $baseBalance - $newQty),
                            'oum' => $itemData['oum'] ?? 'PCS',
                            'price' => $itemData['unit_price'] ?? 0,
                            'cost' => $product->cost ?? 0,
                            'remarks' => 'Sales Order Edit - Initial Ledger Entry',
                        ]);
                        $product->on_hand = max(0, ($product->on_hand ?? 0) - $newQty);
                    }
                    else if ($diff > 0) {
                        // Quantity increased - deduct the difference
                        \App\Models\ProductLedger::create([
                            'product_id' => $product->id,
                            'customer_id' => $so->customer_id,
                            'transaction_type' => 'OUT',
                            'date' => now()->toDateString(),
                            'transaction_number' => $so->order_number,
                            'reference_number' => $normalizedInvoices->implode(', '),
                            'entity_name' => $so->customer_name,
                            'quantity_in' => 0,
                            'quantity_out' => $diff,
                            'balance_stock' => max(0, $baseBalance - $diff),
                            'oum' => $itemData['oum'] ?? 'PCS',
                            'price' => $itemData['unit_price'] ?? 0,
                            'cost' => $product->cost ?? 0,
                            'remarks' => 'Sales Order Edit - Quantity Increase',
                        ]);
                        \Log::info('Created ledger entry for increase', ['diff' => $diff]);
                        $product->on_hand = max(0, ($product->on_hand ?? 0) - $diff);
                    } else if ($diff < 0) {
                        // Quantity decreased - return stock
                        $returnQty = abs($diff);
                        \App\Models\ProductLedger::create([
                            'product_id' => $product->id,
                            'customer_id' => $so->customer_id,
                            'transaction_type' => 'IN',
                            'date' => now()->toDateString(),
                            'transaction_number' => $so->order_number,
                            'reference_number' => $normalizedInvoices->implode(', '),
                            'entity_name' => $so->customer_name,
                            'quantity_in' => $returnQty,
                            'quantity_out' => 0,
                            'balance_stock' => $baseBalance + $returnQty,
                            'oum' => $itemData['oum'] ?? 'PCS',
                            'price' => $itemData['unit_price'] ?? 0,
                            'cost' => $product->cost ?? 0,
                            'remarks' => 'Sales Order Edit - Quantity Decrease',
                        ]);
                        \Log::info('Created ledger entry for decrease', ['returnQty' => $returnQty]);
                        $product->on_hand = ($product->on_hand ?? 0) + $returnQty;
                    } else {
                        \Log::info('No ledger entry - quantity unchanged and ledger exists');
                    }
                }
                // SCENARIO 3: Item NOT in old SO and NOT in Sales Note (completely new item)
                else if ($oldQty == 0 && $noteQty == 0) {
                    \Log::info('Scenario 3: Brand new item', ['newQty' => $newQty]);
                    // Brand new item - deduct full quantity
                    \App\Models\ProductLedger::create([
                        'product_id' => $product->id,
                        'customer_id' => $so->customer_id,
                        'transaction_type' => 'OUT',
                        'date' => now()->toDateString(),
                        'transaction_number' => $so->order_number,
                        'reference_number' => $normalizedInvoices->implode(', '),
                        'entity_name' => $so->customer_name,
                        'quantity_in' => 0,
                        'quantity_out' => $newQty,
                        'balance_stock' => max(0, $baseBalance - $newQty),
                        'oum' => $itemData['oum'] ?? 'PCS',
                        'price' => $itemData['unit_price'] ?? 0,
                        'cost' => $product->cost ?? 0,
                        'remarks' => 'Sales Order Edit - New Item',
                    ]);
                    \Log::info('Created ledger entry for new item', ['newQty' => $newQty]);
                    $product->on_hand = max(0, ($product->on_hand ?? 0) - $newQty);
                }

                $product->save();
                $processedCount++;
            }

            // 4. Items removed entirely from sales order — return their stock
            foreach ($oldQtyMap as $pid => $oldQty) {
                if (in_array($pid, $processedPids)) continue;
                if ($oldQty <= 0) continue;

                $product = \App\Models\Product::on('masterlist')->find($pid);
                if (!$product) continue;

                $baseBalance = (float) ($ledgerBalanceMap[(int) $pid] ?? $product->on_hand ?? 0);
                \App\Models\ProductLedger::create([
                    'product_id' => $product->id,
                    'customer_id' => $so->customer_id,
                    'transaction_type' => 'IN',
                    'date' => now()->toDateString(),
                    'transaction_number' => $so->order_number,
                    'reference_number' => $normalizedInvoices->implode(', '),
                    'entity_name' => $so->customer_name,
                    'quantity_in' => $oldQty,
                    'quantity_out' => 0,
                    'balance_stock' => $baseBalance + $oldQty,
                    'oum' => 'PCS',
                    'price' => 0,
                    'cost' => $product->cost ?? 0,
                    'remarks' => 'Sales Order Edit - Item Removed',
                ]);
                $product->on_hand = ($product->on_hand ?? 0) + $oldQty;
                $product->save();
            }

            // 5. Replace invoices (full replacement from user input)
            $invoiceText = $normalizedInvoices->isNotEmpty()
                ? $normalizedInvoices->implode(', ')
                : ($so->invoice_numbers ?? '');

            // 5. Update sales_order
            \Illuminate\Support\Facades\DB::connection('sales')->table('sales_orders')
                ->where('id', $so->id)
                ->update([
                    'invoice_numbers' => $invoiceText,
                    'waybill_no' => $waybillNo ?: $so->waybill_no,
                    'waybill_date' => $waybillDate ?: $so->waybill_date,
                    'total_amount' => $requestTotalAmount,
                    'remarks' => $remarks !== '' ? $remarks : $so->remarks,
                    'updated_at' => now(),
                ]);

            // 6. Update sales_note status based on ALL invoices, not just this one
            $hasRemaining = false;
            $noteItemsForStatus = \Illuminate\Support\Facades\DB::connection('sales')
                ->table('sales_note_items')
                ->where('sales_note_id', $note->id)
                ->get(['product_id', 'quantity']);
            $allServed = \Illuminate\Support\Facades\DB::connection('sales')
                ->table('sales_orders as so')
                ->join('sales_order_items as soi', 'soi.sales_order_id', '=', 'so.id')
                ->where('so.sales_note_id', $note->id)
                ->select('soi.product_id', \Illuminate\Support\Facades\DB::raw('SUM(COALESCE(soi.actual_qty, 0)) as total_served'))
                ->groupBy('soi.product_id')
                ->get()
                ->keyBy('product_id');
            foreach ($noteItemsForStatus as $noteItem) {
                $orderedQty = (float) ($noteItem->quantity ?? 0);
                $servedQty = (float) (($allServed->get($noteItem->product_id)->total_served ?? 0));
                if ($orderedQty > $servedQty) {
                    $hasRemaining = true;
                    break;
                }
            }
            $note->status = $hasRemaining ? 'Partial' : 'Closed';
            $note->save();

            $soAfter = \App\Models\SalesOrder::on('sales')->with('items')->find($so->id);
            $actor = hatdogAuditActor($user);
            $recordName = trim((string) (($so->customer_name ?? '') !== '' ? $so->customer_name : ('Sales Order ' . ($so->order_number ?? $so->id))));

            hatdogWriteAuditTrail([
                'module' => 'sales_order',
                'action' => 'Updated',
                'source_connection' => 'sales',
                'source_table' => 'sales_orders',
                'source_id' => $so->id,
                'display_id' => (string) ($so->order_number ?? $so->id),
                'record_name' => $recordName,
                'user_name' => $actor['name'],
                'user_identifier' => $actor['identifier'],
                'audit_data' => [
                    'sales_order_before' => $soBefore,
                    'sales_order_after' => $soAfter?->toArray(),
                    'sales_order_items_after' => $soAfter?->items?->map(fn ($i) => $i->toArray())->values()->all() ?? [],
                    'sales_note_before' => $noteBefore,
                    'sales_note_after' => $note->fresh()->toArray(),
                    'customer' => $customer?->toArray(),
                    'invoice_numbers' => $normalizedInvoices->values()->all(),
                    'request_items' => collect($items)->values()->all(),
                ],
            ]);

            \Illuminate\Support\Facades\DB::connection('sales')->commit();
            \Illuminate\Support\Facades\DB::connection('ledger')->commit();
            \Illuminate\Support\Facades\DB::connection('masterlist')->commit();

            \Log::info('Edit SO Transaction committed successfully', [
                'sales_order_id' => $so->id,
                'items_processed' => $processedCount,
            ]);

            return response()->json(['success' => true, 'note_status' => $note->status]);

        } catch (\Exception $dbEx) {
            \Illuminate\Support\Facades\DB::connection('sales')->rollBack();
            \Illuminate\Support\Facades\DB::connection('ledger')->rollBack();
            \Illuminate\Support\Facades\DB::connection('masterlist')->rollBack();
            
            \Log::error('Edit SO Transaction rollback', [
                'error' => $dbEx->getMessage(),
                'trace' => $dbEx->getTraceAsString(),
            ]);
            
            throw $dbEx;
        }
    } catch (\Exception $e) {
        return response()->json(['success' => false, 'message' => $e->getMessage()], 422);
    }
})->name('admin.sales-order.update');

