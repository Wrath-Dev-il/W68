        $applyDateFilter = function ($q, $col = 'order_date') use ($dateType, $date, $dateFrom, $dateTo) {
            if ($dateType === 'monthly' && preg_match('/^\d{4}-\d{2}$/', $date)) {
                [$y, $m] = explode('-', $date);
                $q->whereYear($col, (int) $y)->whereMonth($col, (int) $m);
            } elseif ($dateType === 'annual' && preg_match('/^\d{4}$/', $date)) {
                $q->whereYear($col, (int) $date);
            } elseif ($dateType === 'as-of' && preg_match('/^\d{4}-\d{2}-\d{2}$/', $date)) {
                $q->whereDate($col, '<=', $date);
            } elseif ($dateType === 'from-to' && preg_match('/^\d{4}-\d{2}-\d{2}$/', $dateFrom) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $dateTo)) {
                $q->whereDate($col, '>=', $dateFrom)->whereDate($col, '<=', $dateTo);
            }
        };

        // ---- Date range label ----
        $dateRangeLabel = '';
        if ($dateType === 'monthly' && $date) {
            $d = \Carbon\Carbon::parse($date . '-01');
            $dateRangeLabel = $d->format('d-M-y') . ' To ' . $d->copy()->endOfMonth()->format('d-M-y');
        } elseif ($dateType === 'annual' && $date) {
            $y2 = substr($date, -2);
            $dateRangeLabel = '01-Jan-' . $y2 . ' To 31-Dec-' . $y2;
        } elseif ($dateType === 'as-of' && $date) {
            $dateRangeLabel = 'Up To ' . \Carbon\Carbon::parse($date)->format('d-M-y');
        } elseif ($dateType === 'from-to' && $dateFrom && $dateTo) {
            $dateRangeLabel = \Carbon\Carbon::parse($dateFrom)->format('d-M-y') . ' To ' . \Carbon\Carbon::parse($dateTo)->format('d-M-y');
        }

        // ---- Fetch customers ----
        $customerQuery = DB::connection('masterlist')->table('customers');
        if ($customer !== null) {
            $customerQuery->where('name', 'like', '%' . $customer . '%');
        }
        $customers = $customerQuery->orderBy('name')->get(['id', 'name', 'address', 'terms']);
        if ($customers->isEmpty()) {
            return response()->json(['success' => false, 'message' => 'No customers found.'], 422);
        }
        $customerIds = $customers->pluck('id')->toArray();

        // ---- Fetch sales orders (debits) ----
        $soQuery = DB::connection('sales')->table('sales_orders')
            ->leftJoin('sales_notes', 'sales_notes.id', '=', 'sales_orders.sales_note_id')
            ->whereIn('sales_orders.customer_id', $customerIds)
            ->where(function ($q) {
                $q->where('sales_orders.status', 'Closed')->orWhere('sales_orders.status', 'Confirmed');
            })
            ->whereNotNull('sales_orders.total_amount')
            ->where('sales_orders.total_amount', '>', 0);

        if ($agent !== '' && strtoupper($agent) !== 'SELECT ALL') {
            $soQuery->where('sales_notes.salesman', 'like', '%' . $agent . '%');
        }

        $soQuery->select(
            'sales_orders.id',
            'sales_orders.customer_id',
            'sales_orders.customer_name',
            'sales_orders.order_number',
            'sales_orders.invoice_numbers',
            'sales_orders.total_amount',
            'sales_orders.remarks',
            'sales_orders.sales_note_id',
            'sales_notes.remarks as sales_note_remarks',
            DB::raw('COALESCE(sales_orders.created_at, sales_notes.order_date) as order_date')
        );

        $applyDateFilter($soQuery, 'order_date');
        $salesOrders = $soQuery
            ->orderBy('sales_orders.customer_id')
            ->orderBy('order_date')
            ->orderBy('sales_orders.order_number')
            ->get();

        if ($salesOrders->isEmpty()) {
            return response()->json(['success' => false, 'message' => 'No sales orders found for the selected criteria.'], 422);
        }

        $orderIds = $salesOrders->pluck('id')->toArray();

        // ---- Fetch payments (credits) linked to sales orders ----
        $paymentRows = DB::connection('accounting')->table('process_payment_invoices')
            ->where('source_type', 'sales_order')
            ->whereIn('source_id', $orderIds)
            ->where('paid_amount', '>', 0)
            ->select('source_id', 'paid_amount', 'remarks', 'process_payment_id')
            ->get();

        $paymentPIds = $paymentRows->pluck('process_payment_id')->unique()->toArray();
        $paymentDateMap = [];
        if (!empty($paymentPIds)) {
            $paymentDateMap = DB::connection('accounting')->table('process_payments')
                ->whereIn('id', $paymentPIds)
                ->pluck('payment_date', 'id')
                ->toArray();
        }

        $paymentsByOrderId = [];
        foreach ($paymentRows as $pr) {
            $sid = (int) $pr->source_id;
            if (!isset($paymentsByOrderId[$sid])) {
                $paymentsByOrderId[$sid] = [];
            }
            $paymentsByOrderId[$sid][] = [
                'date' => $paymentDateMap[$pr->process_payment_id] ?? null,
                'amount' => (float) ($pr->paid_amount ?? 0),
                'remarks' => $pr->remarks ?: 'Payment',
            ];
        }

        // ---- Fetch returns (credits) matched by invoice_no ----
        $returnRows = DB::connection('sales')->table('sales_returns')
            ->whereIn('customer_id', $customerIds)
            ->whereNotNull('invoice_no')
            ->where('total_amount', '>', 0)
            ->whereRaw("UPPER(TRIM(COALESCE(status, ''))) NOT IN ('CANCELLED', 'VOID')")
            ->select('id', 'return_number', 'invoice_no', 'total_amount', 'created_at', 'remarks')
            ->get();

        $returnsByInvoice = [];
        foreach ($returnRows as $rr) {
            $rawInv = trim((string) ($rr->invoice_no ?? ''));
            $tokens = preg_split('/[,\s\/]+/', $rawInv);
            foreach ($tokens as $token) {
                $norm = strtoupper(preg_replace('/\s+/', '', trim($token)));
                if ($norm === '') continue;
                if (!isset($returnsByInvoice[$norm])) {
                    $returnsByInvoice[$norm] = [];
                }
                $retRemarks = $rr->remarks ?? '';
                $returnsByInvoice[$norm][] = [
                    'date' => $rr->created_at,
                    'amount' => (float) ($rr->total_amount ?? 0),
                    'remarks' => ($retRemarks !== '') ? 'Return: ' . $retRemarks : '',
                ];
            }
        }

        // ---- Build customer sections with transactions ----
        $customerSections = [];
        foreach ($customers as $cust) {
            $cid = (int) $cust->id;
            $custOrders = $salesOrders->filter(fn($o) => (int) $o->customer_id === $cid)->values();
            if ($custOrders->isEmpty()) continue;

            $transactions = [];
            foreach ($custOrders as $so) {
                $soId = (int) $so->id;
                $invNo = !empty($so->invoice_numbers) ? $so->invoice_numbers : $so->order_number;
                $dateStr = $so->order_date ? \Carbon\Carbon::parse($so->order_date)->format('Y-m-d') : '';

                // Get invoice numbers for return matching
                $orderInvNos = [];
                if (!empty($so->invoice_numbers)) {
                    $orderInvNos = array_map('trim', explode(',', $so->invoice_numbers));
                }
                $orderInvNos[] = $so->order_number;
                $orderInvNos = array_values(array_unique(array_filter($orderInvNos)));

                // Aggregate return credits + remarks per invoice
                $totalReturnCredits = 0;
                $returnRemarks = [];
                foreach ($orderInvNos as $oinv) {
                    $normOinv = strtoupper(preg_replace('/\s+/', '', $oinv));
                    if (isset($returnsByInvoice[$normOinv])) {
                        foreach ($returnsByInvoice[$normOinv] as $ret) {
                            $totalReturnCredits += $ret['amount'];
                            $returnRemarks[] = $ret['remarks'];
                        }
                    }
                }

                // Aggregate payment credits per order
                $totalPaymentCredits = 0;
                if (isset($paymentsByOrderId[$soId])) {
                    foreach ($paymentsByOrderId[$soId] as $pmt) {
                        $totalPaymentCredits += $pmt['amount'];
                    }
                }

                // Build combined remarks: Sales Note + Return
                $remarksParts = [];
                $snRemarks = $so->sales_note_remarks ?? '';
                if ($snRemarks !== '') {
                    $remarksParts[] = 'Sales Note: ' . $snRemarks;
                }
                $nonEmptyReturnRemarks = array_values(array_filter(array_unique($returnRemarks), fn($r) => $r !== ''));
                if (!empty($nonEmptyReturnRemarks)) {
                    $remarksParts[] = implode(' | ', $nonEmptyReturnRemarks);
                }
                $combinedRemarks = implode(' | ', $remarksParts);

                // Single row per invoice with aggregated debits/credits
                $transactions[] = [
                    'date' => $dateStr,
                    'invoice_no' => $invNo,
                    'debits' => (float) ($so->total_amount ?? 0),
                    'credits' => $totalReturnCredits + $totalPaymentCredits,
                    'balance' => 0.0,
                    'remarks' => $combinedRemarks,
                    'sort_key' => $dateStr . '|' . $invNo . '|0',
                ];
            }

            if (empty($transactions)) continue;

            // Sort by date, then invoice_no, debits before credits
            usort($transactions, function ($a, $b) {
                return strcmp($a['sort_key'], $b['sort_key']);
            });

            // Calculate running balance, remove sort_key
            $runningBalance = 0.0;
            foreach ($transactions as &$txn) {
                $runningBalance += $txn['debits'] - $txn['credits'];
                $txn['balance'] = $runningBalance;
                unset($txn['sort_key']);
            }
            unset($txn);

            $customerSections[] = [
                'customer' => $cust,
                'transactions' => $transactions,
                'total_balance' => $runningBalance,
            ];
        }

        if (empty($customerSections)) {
            return response()->json(['success' => false, 'message' => 'No data to display.'], 422);
        }

        // ---- Build paginated pages (max ~35 rows per A4 page) ----
        $ROWS_PER_PAGE = 35;
        $pages = [];

        foreach ($customerSections as $section) {
            $cust = $section['customer'];
            $txns = $section['transactions'];
            $totalBalance = $section['total_balance'];

            $chunks = array_chunk($txns, $ROWS_PER_PAGE);
            $chunkCount = count($chunks);

            foreach ($chunks as $chunkIndex => $chunk) {
                $pages[] = [
                    'customer' => [
                        'id' => $cust->id,
                        'name' => $cust->name,
                        'address' => $cust->address ?? '',
                        'terms' => $cust->terms ?? '',
                    ],
                    'rows' => $chunk,
                    'show_customer_box' => ($chunkIndex === 0),
                    'show_payment_summary' => ($chunkIndex === $chunkCount - 1),
                    'total_balance' => ($chunkIndex === $chunkCount - 1) ? $totalBalance : 0,
                ];
            }
        }

        // Assign page numbers
        $totalPageCount = count($pages);
        foreach ($pages as $idx => &$page) {
            $page['page_number'] = $idx + 1;
            $page['total_pages'] = $totalPageCount;
        }
        unset($page);

        // ---- User info for footer ----
        $userId = '';
        $userLoginId = '';
        if (is_array($user)) {
            $userId = $user['User_ID'] ?? '';
            $userLoginId = $user['login_ID'] ?? '';
        } else {
            $userId = $user->User_ID ?? '';
            $userLoginId = $user->login_ID ?? '';
        }

        return view('Admin.Reports.prints.sales-report-print', [
            'pages' => $pages,
            'dateRangeLabel' => $dateRangeLabel,
            'timestamp' => \Carbon\Carbon::now()->format('m-d-Y h:i A'),
            'printedBy' => $userId ?: $userLoginId,
            'securityId' => \Illuminate\Support\Str::uuid()->toString(),
        ]);
    } catch (\Throwable $e) {
        Log::error('SOA print error: ' . $e->getMessage() . "\n" . $e->getTraceAsString());
        return response()->json(['success' => false, 'message' => $e->getMessage()], 422);
    }
})->name('admin.sales-report.print-soa');

