Route::get('/admin/sales/sales-return/invoices', function (Request $request) {
    $user = session('user');
    if (!$user) return response()->json(['error' => 'Unauthorized'], 403);
    try {
        $search = $request->query('search');
        $page = (int)$request->query('page', 1);
        $perPage = 50;

        // Build base query - use sales_orders table
        $query = DB::connection('sales')->table('sales_orders')
            ->where('status', 'Confirmed');

        if ($search) {
            $query->where(function($q) use ($search) {
                $q->where('invoice_numbers', 'LIKE', "%{$search}%")
                  ->orWhere('customer_name', 'LIKE', "%{$search}%");
            });
        }

        $totalCount = $query->count();
        
        $orders = $query
            ->orderBy('created_at', 'desc')
            ->offset(($page - 1) * $perPage)
            ->limit($perPage)
            ->get();

        $invoices = $orders->map(function ($order) {
            // Use order_number if sales_note_id doesn't exist, or just use id
            $noteId = property_exists($order, 'sales_note_id') ? $order->sales_note_id : $order->id;
            
            return [
                'id' => $noteId ?: $order->id,
                'no' => $order->invoice_numbers ?: '---',
                'customer_id' => $order->customer_id ?? 0,
                'customer' => $order->customer_name ?? '---',
                'amount' => $order->net_total ?? $order->total_amount ?? 0,
                'created_at' => $order->created_at,
            ];
        });

        return response()->json([
            'success' => true, 
            'invoices' => $invoices,
            'total' => $totalCount,
            'page' => $page,
            'last_page' => ceil($totalCount / $perPage)
        ]);
    } catch (\Exception $e) {
        \Log::error('Sales Return Invoices Error: ' . $e->getMessage() . ' | File: ' . $e->getFile() . ' | Line: ' . $e->getLine());
        return response()->json(['success' => false, 'message' => $e->getMessage(), 'file' => $e->getFile(), 'line' => $e->getLine()], 422);
