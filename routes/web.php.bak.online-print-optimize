// Sales Return - Update
Route::post('/admin/sales/sales-return/update/{id}', function (Request $request, $id) {
    $user = session('user');
    if (!$user) return response()->json(['error' => 'Unauthorized'], 403);
    try {
        $header = DB::connection('sales')->table('sales_returns')->where('id', $id)->first();
        if (!$header) throw new \Exception('Return not found');

        $items = $request->input('items', []);
        $generalRemarks = $request->input('remarks', '');
        $returnNo = $header->return_number;
        $actor = hatdogAuditActor($user);

        DB::connection('sales')->beginTransaction();
        DB::connection('ledger')->beginTransaction();
        DB::connection('masterlist')->beginTransaction();

        $newTotalItems = 0;
        $newTotalAmount = 0;
        $newSubtotal = 0;

        foreach ($items as $item) {
            $productId = $item['product_id'] ?? null;
            if (!$productId) continue;

            $qty = max(0, (int)($item['qty'] ?? 0));
            $goodItems = max(0, (int)($item['good_items'] ?? 0));
            $goodItems = min($goodItems, $qty);
            $unitPrice = (float)($item['unit_price'] ?? 0);
            $itemDisc = (float)($item['discount'] ?? 0);
            $itemRemarks = (string)($item['remarks'] ?? '');

            $existingItem = DB::connection('sales')->table('sales_return_items')
                ->where('sales_return_id', $id)
                ->where('product_id', $productId)
                ->first();

            if ($existingItem) {
                $qtyChanged = ($existingItem->quantity != $qty);
                $goodQtyChanged = ($existingItem->good_qty != $goodItems);
                $remarksChanged = ($existingItem->remarks != $itemRemarks);
                $discountChanged = ((float)($existingItem->discount ?? 0) != $itemDisc);

                if (!$qtyChanged && !$goodQtyChanged && !$remarksChanged && !$discountChanged) {
                    // Requirement 3: unchanged — skip, keep existing totals
                    $newTotalItems += $existingItem->quantity;
                    $newTotalAmount += $existingItem->return_amount;
                    $existingGrossSubtotal = (float)($existingItem->subtotal ?? ((float)$existingItem->quantity * (float)$existingItem->unit_price));
                    $existingDisc = (float)($existingItem->discount ?? 0);
                    $newSubtotal += $existingGrossSubtotal * (1 - $existingDisc / 100);
                    continue;
                }

                // Requirement 6: changed — update sales_return_items
                $grossSubtotal = $qty * $unitPrice;
                $afterItemDisc = $grossSubtotal * (1 - $itemDisc / 100);
                $amount = $afterItemDisc;

                DB::connection('sales')->table('sales_return_items')
                    ->where('id', $existingItem->id)
                    ->update([
                        'quantity' => $qty,
                        'good_qty' => $goodItems,
                        'discount' => $itemDisc,
                        'subtotal' => $grossSubtotal,
                        'return_amount' => $amount,
                        'remarks' => $itemRemarks,
                        'updated_at' => now()
                    ]);

                $ledgerEntry = DB::connection('ledger')->table('product_ledgers')
                    ->where('transaction_number', $returnNo)
                    ->where('product_id', $productId)
                    ->first();

                $oldGoodQty = (int)$existingItem->good_qty;
                $goodQtyDelta = $goodItems - $oldGoodQty;

                $stockUpdated = false;

                if ($ledgerEntry) {
                    $newBalance = max(0, (int)$ledgerEntry->balance_stock + $goodQtyDelta);
                    DB::connection('ledger')->table('product_ledgers')
                        ->where('id', $ledgerEntry->id)
                        ->update([
                            'quantity_in' => $goodItems,
                            'balance_stock' => $newBalance,
                            'updated_at' => now()
                        ]);
                } elseif ($goodItems > 0) {
                    $product = \App\Models\Product::on('masterlist')
                        ->where('id', $productId)->lockForUpdate()->first();
                    $currentStock = $product ? (int)$product->on_hand : 0;
                    $newBalance = $currentStock + $goodItems;

                    DB::connection('ledger')->table('product_ledgers')->insert([
                        'product_id' => (int)$productId,
                        'customer_id' => !empty($header->customer_id) ? (int)$header->customer_id : null,
                        'transaction_type' => 'IN',
                        'date' => now()->toDateString(),
                        'transaction_number' => $returnNo,
                        'reference_number' => (string)($header->invoice_no ?? ''),
                        'entity_name' => (string)($header->customer_name ?? ''),
                        'quantity_in' => $goodItems,
                        'quantity_out' => 0,
                        'balance_stock' => $newBalance,
                        'oum' => 'PCS',
                        'price' => $unitPrice,
                        'cost' => $product ? (float)($product->cost ?? 0) : 0,
                        'remarks' => trim('Sales Return Good Items' . ($itemRemarks !== '' ? ' - ' . $itemRemarks : '')),
                        'created_at' => now(),
                        'updated_at' => now()
                    ]);

                    if ($product) {
                        $product->on_hand = $newBalance;
                        $product->save();
                        $stockUpdated = true;
                    }
                }

                if ($goodQtyDelta != 0 && !$stockUpdated) {
                    $product = \App\Models\Product::on('masterlist')
                        ->where('id', $productId)->lockForUpdate()->first();
                    if ($product) {
                        $product->on_hand = max(0, (int)$product->on_hand + $goodQtyDelta);
                        $product->save();
                    }
                }

                $newTotalItems += $qty;
                $newTotalAmount += $amount;
                $newSubtotal += $afterItemDisc;

            } else {
                if ($qty <= 0 && $goodItems <= 0) {
                    // Requirement 5: no return value — skip
                    continue;
                }

                $grossSubtotal = $qty * $unitPrice;
                $afterItemDisc = $grossSubtotal * (1 - $itemDisc / 100);
                $amount = $afterItemDisc;

                DB::connection('sales')->table('sales_return_items')->insert([
                    'sales_return_id' => $id,
                    'product_id' => $productId,
                    'product_code' => $item['product_code'] ?? '',
                    'part_number' => $item['part_number'] ?? '',
                    'description' => $item['description'] ?? '',
                    'application' => $item['application'] ?? '',
                    'quantity' => $qty,
                    'good_qty' => $goodItems,
                    'discount' => $itemDisc,
                    'unit_price' => $unitPrice,
                    'subtotal' => $grossSubtotal,
                    'return_amount' => $amount,
                    'remarks' => $itemRemarks,
                    'created_at' => now(),
                    'updated_at' => now()
                ]);

                // Requirement 4: check product_ledgers
                if ($goodItems > 0) {
                    $ledgerEntry = DB::connection('ledger')->table('product_ledgers')
                        ->where('transaction_number', $returnNo)
                        ->where('product_id', $productId)
                        ->first();

                    if (!$ledgerEntry) {
                        $product = \App\Models\Product::on('masterlist')
                            ->where('id', $productId)->lockForUpdate()->first();
                        $currentStock = $product ? (int)$product->on_hand : 0;
                        $newBalance = $currentStock + $goodItems;

                        DB::connection('ledger')->table('product_ledgers')->insert([
                            'product_id' => (int)$productId,
                            'customer_id' => !empty($header->customer_id) ? (int)$header->customer_id : null,
                            'transaction_type' => 'IN',
                            'date' => now()->toDateString(),
                            'transaction_number' => $returnNo,
                            'reference_number' => (string)($header->invoice_no ?? ''),
                            'entity_name' => (string)($header->customer_name ?? ''),
                            'quantity_in' => $goodItems,
                            'quantity_out' => 0,
                            'balance_stock' => $newBalance,
                            'oum' => 'PCS',
                            'price' => $unitPrice,
                            'cost' => $product ? (float)($product->cost ?? 0) : 0,
                            'remarks' => trim('Sales Return Good Items' . ($itemRemarks !== '' ? ' - ' . $itemRemarks : '')),
                            'created_at' => now(),
                            'updated_at' => now()
                        ]);

                        if ($product) {
                            $product->on_hand = $newBalance;
                            $product->save();
                        }
                    }
                }

                $newTotalItems += $qty;
                $newTotalAmount += $amount;
                $newSubtotal += $afterItemDisc;
            }
        }

        $headerAddlDiscPct = (float)$header->additional_discount_percent;
        $addlDiscAmt = $newSubtotal * $headerAddlDiscPct / 100;
        $newTotalAfterAddlDisc = $newSubtotal - $addlDiscAmt;

        DB::connection('sales')->table('sales_returns')
            ->where('id', $id)
            ->update([
                'total_items' => $newTotalItems,
                'total_amount' => $newTotalAfterAddlDisc,
                'subtotal' => $newSubtotal,
                'additional_discount_amount' => $addlDiscAmt,
                'remarks' => $generalRemarks,
                'updated_at' => now()
            ]);

        DB::connection('masterlist')->commit();
        DB::connection('ledger')->commit();
        DB::connection('sales')->commit();

        $updatedReturn = DB::connection('sales')->table('sales_returns')->where('id', $id)->first();
        $updatedItems = DB::connection('sales')->table('sales_return_items')
            ->where('sales_return_id', $id)->get()->map(fn($i) => (array)$i)->values()->all();
        $customer = $header->customer_id ? \App\Models\Customer::on('masterlist')->find($header->customer_id) : null;

        hatdogWriteAuditTrail([
            'module' => 'sales_return',
            'action' => 'Edited',
            'source_connection' => 'sales',
            'source_table' => 'sales_returns',
            'source_id' => $id,
            'display_id' => $returnNo,
            'record_name' => $header->customer_name ?: 'Sales Return ' . $returnNo,
            'user_name' => $actor['name'],
            'user_identifier' => $actor['identifier'],
            'audit_data' => [
                'sales_return' => $updatedReturn ? (array)$updatedReturn : null,
                'customer' => $customer?->toArray(),
                'items' => $updatedItems,
            ],
        ]);

        return response()->json(['success' => true]);
    } catch (\Exception $e) {
        if (DB::connection('masterlist')->transactionLevel() > 0) DB::connection('masterlist')->rollBack();
        if (DB::connection('ledger')->transactionLevel() > 0) DB::connection('ledger')->rollBack();
        if (DB::connection('sales')->transactionLevel() > 0) DB::connection('sales')->rollBack();
        \Illuminate\Support\Facades\Log::error('Sales Return Update Error: ' . $e->getMessage());
        return response()->json(['success' => false, 'message' => $e->getMessage()], 422);
    }
})->name('admin.sales-return.update');

// Sales Return - Delete
Route::post('/admin/sales/sales-return/delete/{id}', function (Request $request, $id) {
    $user = session('user');
    if (!$user) return response()->json(['error' => 'Unauthorized'], 403);
    try {
        $header = DB::connection('sales')->table('sales_returns')->where('id', $id)->first();
        if (!$header) throw new \Exception('Return not found');

        $returnNo = $header->return_number;
        $actor = hatdogAuditActor($user);

        DB::connection('sales')->beginTransaction();
        DB::connection('ledger')->beginTransaction();
        DB::connection('masterlist')->beginTransaction();

        $items = DB::connection('sales')->table('sales_return_items')
            ->where('sales_return_id', $id)
            ->get();

        // Reverse stock: subtract good_qty from product_ledgers and products
        foreach ($items as $item) {
            $goodQty = (int)$item->good_qty;
            if ($goodQty > 0) {
                $ledgerEntry = DB::connection('ledger')->table('product_ledgers')
                    ->where('transaction_number', $returnNo)
                    ->where('product_id', $item->product_id)
                    ->first();

                if ($ledgerEntry) {
                    DB::connection('ledger')->table('product_ledgers')
                        ->where('id', $ledgerEntry->id)
                        ->delete();

                    $product = \App\Models\Product::on('masterlist')
                        ->where('id', $item->product_id)->lockForUpdate()->first();
                    if ($product) {
                        $product->on_hand = max(0, (int)$product->on_hand - $goodQty);
                        $product->save();
                    }
                }
            }
        }

        DB::connection('sales')->table('sales_return_items')
            ->where('sales_return_id', $id)
            ->delete();

        DB::connection('sales')->table('sales_returns')
            ->where('id', $id)
            ->delete();

        hatdogWriteAuditTrail([
            'module' => 'sales_return',
            'action' => 'Deleted',
            'source_connection' => 'sales',
            'source_table' => 'sales_returns',
            'source_id' => $id,
            'display_id' => $returnNo,
            'record_name' => trim((string) ($header->customer_name ?? ('Sales Return ' . $returnNo))),
            'user_name' => $actor['name'],
            'user_identifier' => $actor['identifier'],
            'audit_data' => [
                'sales_return' => (array) $header,
                'items' => $items->map(fn ($i) => (array) $i)->values()->all(),
            ],
        ]);

        DB::connection('masterlist')->commit();
        DB::connection('ledger')->commit();
        DB::connection('sales')->commit();
        return response()->json(['success' => true, 'message' => 'Sales return deleted successfully']);
    } catch (\Exception $e) {
        if (DB::connection('masterlist')->transactionLevel() > 0) DB::connection('masterlist')->rollBack();
        if (DB::connection('ledger')->transactionLevel() > 0) DB::connection('ledger')->rollBack();
        if (DB::connection('sales')->transactionLevel() > 0) DB::connection('sales')->rollBack();
        \Illuminate\Support\Facades\Log::error('Sales Return Delete Error: ' . $e->getMessage());
        return response()->json(['success' => false, 'message' => $e->getMessage()], 422);
    }
})->name('admin.sales-return.delete');

