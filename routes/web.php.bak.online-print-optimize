                if ($_resolvedPrice <= 0 && $item->id && isset($prices[$noteIdx . '-' . $item->id]) && (float)$prices[$noteIdx . '-' . $item->id] > 0) {
                    $_resolvedPrice = (float)$prices[$noteIdx . '-' . $item->id];
                }
                $_itemPriceOnline = $product ? $product->price_online : 0;
                if ($_resolvedPrice <= 0 && $_itemPriceOnline > 0) {
                    $_resolvedPrice = (float)$_itemPriceOnline;
                }
                if ($_resolvedPrice <= 0 && $item->unit_price > 0) {
                    $_resolvedPrice = (float)$item->unit_price;
                }
                if ($_resolvedPrice <= 0 && $product && $product->selling_price > 0) {
                    $_resolvedPrice = (float)$product->selling_price;
