        $safe = $escapeLike($brand);
        // Strip spaces from both sides so 'AUTO STAR' also matches 'Autostar' (and vice versa)
        $noSpace = str_replace(' ', '', $safe);
        $query->whereRaw('REPLACE(category, " ", "") LIKE ?', ['%' . $noSpace . '%']);
